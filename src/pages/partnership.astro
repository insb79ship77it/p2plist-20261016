---
import Layout from '../layouts/Layout.astro';
---

<Layout title="제휴/광고문의 — LinkRank" description="LinkRank 제휴 및 배너 광고 문의 안내입니다.">
  <main class="wrap">
    <article class="card">
      <h1>제휴 / 광고문의</h1>
      <p>LinkRank 배너 광고 및 제휴 관련 문의는 아래 이메일로 접수해 주시기 바랍니다.</p>
      <p><strong>E-mail:</strong> contact@linkrank-example.com</p>
    </article>
  </main>
</Layout>

<style>
  .wrap { max-width: 800px; margin: 50px auto; padding: 0 20px; min-height: 60vh; }
  .card { background: #fff; padding: 40px; border-radius: 20px; border: 1px solid var(--line); }
  h1 { font-size: 28px; margin-bottom: 20px; color: var(--ink); }
  p { color: var(--muted); }
</style>
