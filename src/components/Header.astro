---
---
<header>
  <div class="nav">
    <a class="logo" href="/">
      <span class="logo-mark">↗</span>LinkRank
    </a>
    <nav>
      <a href="/#ranking">순위</a>
      <a href="/#quick-guide">선택 가이드</a>
      <a href="/#criteria">평가 기준</a>
      <a href="/#guide">놓치기 쉬운 점</a>
      <a href="/#faq">FAQ</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 66px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav {
    max-width: 1080px;
    height: 100%;
    margin: auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-weight: 900;
    letter-spacing: -0.04em;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: inherit;
    text-decoration: none;
  }
  .logo-mark {
    width: 29px;
    height: 29px;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 15px;
  }
  nav {
    display: flex;
    gap: 28px;
    font-size: 14px;
    color: var(--muted);
    font-weight: 650;
  }
  nav a {
    color: inherit;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .nav { padding: 0 16px; }
    nav { gap: 13px; font-size: 12px; }
  }
</style>
